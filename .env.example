# Optional GitHub token raises the API rate limit. Leave blank for public access.
GITHUB_TOKEN=

# Optional AI provider configuration. Without both values, issue browsing works
# but AI explanations and chat return an honest setup message.
AI_API_KEY=
AI_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
