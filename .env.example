# Optional: raise GitHub's public API/search limit. Keep the token on the server.
GITHUB_TOKEN=

# Kaggle tunnel printed by docs/kaggle_kernel.py; update after notebook restarts.
KAGGLE_KERNEL_URL=
KAGGLE_MODEL=gemma-3-4b-it

# Optional local Gemma fallback when the Kaggle tunnel is unavailable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_FALLBACK_ENABLED=true

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
WEBSITE_ANALYSIS_TIMEOUT_MS=25000
