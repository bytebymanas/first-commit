# Optional GitHub token raises the API rate limit. Leave blank for public access.
GITHUB_TOKEN=

# AI provider configuration is optional. Issue browsing works without it.
AI_API_KEY=
AI_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=
AI_PROVIDER=

# Optional Kaggle GPU inference tunnel URL (configure only when running that service).
KAGGLE_KERNEL_URL=

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
